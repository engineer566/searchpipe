# --- 检索源：SearXNG ---
SEARXNG_URL=http://localhost:8081
# 出站代理（后续接住宅代理防 CAPTCHA，留空则不走代理）
# SEARXNG_PROXY=socks5://user:pass@host:1080

# --- LLM（重排 + 摘要，OpenAI 兼容接口）---
# DeepSeek 示例；也可换 Qwen / OpenAI / 本地 Ollama
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-chat

# --- 搜索行为 ---
MAX_RESULTS=5          # 默认返回结果数
FETCH_TOP_N=5          # 抓取正文的 URL 数
REQUEST_TIMEOUT=20     # 单次请求超时（秒）
LLM_TIMEOUT=30         # LLM 调用超时（秒）

# --- 缓存（可选，MVP 先不启用）---
REDIS_URL=redis://localhost:6379/0
ENABLE_CACHE=false

# === 商业化后端 ===

# --- 数据库 ---
DATABASE_URL=postgresql+asyncpg://ai:ai@localhost:5432/ai
DATABASE_ECHO=false

# --- JWT / 会话 ---
JWT_SECRET=change-me-to-a-random-string
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=30
SESSION_COOKIE_SECRET=change-me-too

# --- 积分计费 ---
FREE_TIER_CREDITS=1000
CREDIT_COST_BASIC=1
CREDIT_COST_ADVANCED=2

# --- 短信验证码（实名制登录，阿里云/腾讯云）---
SMS_PROVIDER=aliyun
SMS_ACCESS_KEY=
SMS_SECRET_KEY=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# --- OAuth ---
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_WECHAT_APP_ID=
OAUTH_WECHAT_APP_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:8001

# --- 支付（虎皮椒过渡）---
PAYMENT_PROVIDER=xunhupay
XUNHUPAY_APPID=
XUNHUPAY_APPSECRET=
XUNHUPAY_NOTIFY_URL=

# --- 内容审核（阿里云内容安全）---
MODERATION_PROVIDER=aliyun
MODERATION_ACCESS_KEY=
MODERATION_SECRET_KEY=
MODERATION_ENABLED=false

# --- 限流 ---
RATE_LIMIT_RPM=100
RATE_LIMIT_BURST=20
