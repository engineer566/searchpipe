# --- 检索源：SearXNG ---
SEARXNG_URL=http://localhost:8081
# 出站代理（后续接住宅代理防 CAPTCHA，留空则不走代理）
# SEARXNG_PROXY=socks5://user:pass@host:1080
# 双环境引擎配置（docker compose 插值用，作用于 searxng 容器）：
# 境外主机用默认 settings.yml 无需设置；境内主机取消下一行注释
# SEARXNG_SETTINGS_PATH=/etc/searxng/settings.cn.yml

# --- LLM（重排 + 摘要，OpenAI 兼容接口）---
# DeepSeek 示例；也可换 Qwen / OpenAI / 本地 Ollama
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-chat

# --- 搜索行为 ---
MAX_RESULTS=5          # 默认返回结果数
FETCH_TOP_N=5          # 抓取正文的 URL 数
REQUEST_TIMEOUT=20     # SearXNG 检索超时（秒）
FETCH_TIMEOUT=12       # 单页正文抓取超时（秒）
FETCH_CONCURRENCY=8    # 正文抓取并发数
LLM_TIMEOUT=30         # LLM 调用超时（秒）

# --- 结果缓存（相同 query+参数；Redis 不可用时自动降级为不缓存）---
REDIS_URL=redis://localhost:6379/0
ENABLE_CACHE=true
SEARCH_CACHE_TTL=300   # 结果缓存 TTL（秒）

# === 商业化后端 ===

# --- 数据库 ---
DATABASE_URL=postgresql+asyncpg://ai:ai@localhost:5432/ai
DATABASE_ECHO=false

# --- JWT / 会话 ---
JWT_SECRET=change-me-to-a-random-string
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=30
SESSION_COOKIE_SECRET=change-me-too
# API Key 明文可查看（api_keys.key_cipher 的对称加密主密钥）
# 留空回退 SESSION_COOKIE_SECRET；生产建议显式配置并备份：换掉后历史 Key 仍可鉴权，但不能再查看明文
KEY_ENCRYPTION_SECRET=

# --- 积分计费 ---
FREE_TIER_CREDITS=1000
CREDIT_COST_BASIC=1
CREDIT_COST_ADVANCED=2

# --- OAuth ---
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:8001

# --- 支付（MoR 代收平台：Creem 或 Dodo Payments，二选一）---
# 两家都是「托管收银台 redirect + JSON webhook 签名验证」；
# 套餐与 provider product 的映射存在 plans.provider_products（DB），这里只放凭证
PAYMENT_PROVIDER=creem          # creem | dodo
# Creem：https://creem.io → Developers → API Keys / Webhooks
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
# test 模式：https://test-api.creem.io
CREEM_API_BASE=https://api.creem.io
# 自定义金额充值用的「$1/单位」按量 product id（units=美元数）
CREEM_CREDIT_PRODUCT_ID=
# Dodo Payments：Dashboard → Developer → API Keys / Webhooks
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
# test 模式：https://test.dodopayments.com
DODO_API_BASE=https://api.dodopayments.com
DODO_CREDIT_PRODUCT_ID=

# --- 充值/订阅规则 ---
CURRENCY=USD
CREDIT_PRICE_RATE=0.005  # $0.005 = 1 积分（自定义充值汇率）
MAX_RECHARGE_USD=500     # 单笔充值上限（美元）

# --- 内容审核（阿里云内容安全）---
MODERATION_PROVIDER=aliyun
MODERATION_ACCESS_KEY=
MODERATION_SECRET_KEY=
MODERATION_ENABLED=false

# --- 限流 ---
RATE_LIMIT_RPM=100
RATE_LIMIT_BURST=20

# --- 邮件（密码重置等事务邮件）---
# SMTP_HOST 留空表示未配置：邮件降级为日志输出（dev 可用）
# 海外投递推荐 Resend（smtp.resend.com:465，user=resend，password=API key）
# 或 AWS SES；阿里企业邮箱发 Gmail 有进垃圾箱风险
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
# 对外访问基址，用于拼密码重置链接、canonical、og:url 与 sitemap
APP_BASE_URL=http://localhost:8001

# --- SEO：站长平台验证（留空则不渲染对应 meta 标签；配完重启生效）---
# Google Search Console → 「HTML 标记」方式里 content 的值
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → msvalidate.01 的值
BING_SITE_VERIFICATION=
